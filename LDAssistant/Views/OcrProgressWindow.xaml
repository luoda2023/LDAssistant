<Window x:Class="LDAssistant.Views.OcrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR进度"
        Width="540" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" IsHitTestVisible="False" Focusable="False"
        SnapsToDevicePixels="True">
    <Border x:Name="Card" Background="#F2FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1"
            CornerRadius="12" Padding="22,14" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="#333333"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
            <TextBlock x:Name="ProgressText" Text="正在识别..." FontSize="14" FontWeight="SemiBold"
                       Foreground="#2563EB" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ProgressBar" Width="320" Height="10" Margin="14,0,0,0"
                         Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="14" FontWeight="SemiBold"
                       Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
