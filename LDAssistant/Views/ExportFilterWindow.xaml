<Window x:Class="LDAssistant.Views.ExportFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出筛选" Width="420" Height="540" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="14">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnAll" Content="全选" Width="64" Margin="0,0,6,0" Padding="0,4" Click="BtnAll_Click"/>
            <Button x:Name="BtnNone" Content="全不选" Width="64" Margin="0,0,12,0" Padding="0,4" Click="BtnNone_Click"/>
            <Button x:Name="BtnOk" Content="导出" Width="72" IsDefault="True" Padding="0,4" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Width="64" Margin="8,0,0,0" Padding="0,4"
                    IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="按来源筛选" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                <TextBlock Text="（默认全选，导出时仅包含勾选的来源）" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,6"/>
                <StackPanel x:Name="SourcePanel"/>

                <TextBlock Text="按状态筛选" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13" Margin="0,16,0,6"/>
                <StackPanel x:Name="StatusPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
