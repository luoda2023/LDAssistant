<Window x:Class="LDAssistant.Views.StandardQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规范标准查询" Width="900" Height="650"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinWidth="600" MinHeight="400"
        WindowStyle="SingleBorderWindow">
    <DockPanel>
        <!-- 顶部标题 -->
        <Border DockPanel.Dock="Top" Background="#2196F3" Padding="12,8">
            <StackPanel>
                <TextBlock Text="🔍 规范标准查询" Foreground="White" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="DbInfo" Text="数据库加载中..." Foreground="#BBDEFB" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 搜索栏 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="BtnSearch" DockPanel.Dock="Right" Content="🔍 查询" Width="70" Height="32"
                            Click="BtnSearch_Click" Background="#2196F3" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Margin="8,0,0,0"/>
                    <TextBox x:Name="SearchBox" FontSize="14" Padding="8,5" VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <!-- 分类下拉 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="分类:" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CategoryCombo" Width="160" FontSize="12">
                            <ComboBoxItem Content="全部分类" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- 状态下拉 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="状态:" VerticalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,0,6,0"/>
                        <ComboBox x:Name="StatusCombo" Width="100" FontSize="12">
                            <ComboBoxItem Content="全部" IsSelected="True"/>
                            <ComboBoxItem Content="现行"/>
                            <ComboBoxItem Content="作废"/>
                            <ComboBoxItem Content="废止"/>
                            <ComboBoxItem Content="有更新版"/>
                            <ComboBoxItem Content="即将实施"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCopy" Content="📋 复制" Width="60" Height="28" FontSize="11"
                                Click="BtnCopy_Click" Margin="0,0,4,0"
                                Background="#F0F0F0" BorderBrush="#DDD"/>
                        <Button x:Name="BtnExportWord" Content="📄 导出Word" Width="80" Height="28" FontSize="11"
                                Click="BtnExportWord_Click"
                                Background="#F0F0F0" BorderBrush="#DDD"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 底部状态 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="ResultInfo" Text="输入编号或名称进行查询" FontSize="12" Foreground="#666"/>
        </Border>

        <!-- 结果表格 -->
        <DataGrid x:Name="ResultGrid" Background="White"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  BorderThickness="0" RowHeight="28"
                  ColumnHeaderHeight="32"
                  AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Id}" Width="50" SortDirection="Ascending"/>
                <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                <DataGridTextColumn Header="发布单位" Binding="{Binding Publisher}" Width="100"/>
                <DataGridTextColumn Header="实施日期" Binding="{Binding ImplementDate}" Width="90"/>
                <DataGridTextColumn Header="替代信息" Binding="{Binding ReplacementRaw}" Width="200"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceType}" Width="80"/>
            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="0.5"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="作废">
                            <Setter Property="Foreground" Value="#F44336"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="废止">
                            <Setter Property="Foreground" Value="#F44336"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="现行">
                            <Setter Property="Foreground" Value="#4CAF50"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="有更新版">
                            <Setter Property="Foreground" Value="#FF9800"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </DockPanel>
</Window>
