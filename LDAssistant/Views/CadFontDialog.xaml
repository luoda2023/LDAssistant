<Window x:Class="LDAssistant.Views.CadFontDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="CAD字宽设置"
	Width="300" Height="140"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	Background="#F7F8FA">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="56"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- 字宽 -->
		<TextBlock Text="字宽:" VerticalAlignment="Center" Margin="0,4,8,4"/>
		<ComboBox x:Name="CboWidthFactor" Grid.Column="1" Height="26" Margin="0,4"
					IsEditable="True" VerticalContentAlignment="Center"
					ToolTip="宽度因子：1.0=原始宽度，小于1变窄，大于1变宽"/>

		<!-- 按钮 -->
		<StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
					HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button Content="应用" Width="75" Height="28" Margin="0,0,8,0" IsDefault="True"
					Click="BtnApply_Click"/>
			<Button Content="取消" Width="75" Height="28" IsCancel="True"
					Click="BtnCancel_Click"/>
		</StackPanel>
	</Grid>
</Window>
