<Window x:Class="LDAssistant.Views.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
Title="LUODA助理 v3.1 — 工程文档智能助手"
Width="1400" Height="900"
WindowState="Maximized"
Background="#F5F5F5"
WindowStartupLocation="CenterScreen"
PreviewKeyDown="Window_PreviewKeyDown">

<Window.Resources>
 <!-- 侧栏视图模板：缩略图（浅灰卡片+页码居中） / 列表（第 N 页） -->
 <DataTemplate x:Key="ThumbGridTemplate">
 <StackPanel Margin="0,0,0,13" HorizontalAlignment="Center" IsHitTestVisible="False">
 <Border x:Name="ThumbFrame" CornerRadius="2" Background="White" Padding="0"
 Width="116" IsHitTestVisible="False"
 BorderBrush="#E2E8F0" BorderThickness="1">
 <Border.Effect>
 <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#707070"/>
 </Border.Effect>
 <Image Source="{Binding Thumbnail}" Width="116" Height="164" Stretch="Uniform"
 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
 </Border>
 <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"
 HorizontalAlignment="Center" Margin="0,5,0,0" IsHitTestVisible="False"/>
 </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="ThumbListTemplate">
 <StackPanel Orientation="Horizontal" Margin="9,7" IsHitTestVisible="False">
 <TextBlock Text="第" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
 <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
 Margin="3,0" VerticalAlignment="Center"/>
 <TextBlock Text="页" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
 </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="OutlineTemplate">
 <Grid HorizontalAlignment="Stretch" Margin="10,5" IsHitTestVisible="False">
 <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#475569"
 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
 </Grid>
 </DataTemplate>
</Window.Resources>

<Grid>
<DockPanel>
 <!-- ═══════════════ 顶部工具栏 ═══════════════ -->
<Border x:Name="ToolbarBorder" DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
 <DockPanel>
 <!-- 右侧：页面信息 -->
 <TextBlock x:Name="PageInfo" Text="无文件" FontSize="12" Foreground="#64748B"
 DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0"/>

 <!-- 工具条主体 -->
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

 <!-- 文件组 -->
 <Border Style="{StaticResource ToolGroup}">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnOpen" Style="{StaticResource ToolBarButton}" Click="BtnOpen_Click" Content="打开" Tag="&#xE8E5;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="打开文件"/><TextBlock Style="{StaticResource TipBody}" Text="选择 PDF、Word、Excel、图片或 CAD 图纸文件进行预览"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnOpenImage" Style="{StaticResource ToolBarButton}" Click="BtnOpenImage_Click" Content="图片" Tag="&#xE91B;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="打开图片"/><TextBlock Style="{StaticResource TipBody}" Text="打开图片文件并可直接进行 OCR 文字识别"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 <!-- 显示全部组 -->
 <Border Style="{StaticResource ToolGroup}">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnFitAll" Style="{StaticResource ToolBarButton}" Click="BtnFitAll_Click" Content="全部" Tag="&#xE71D;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="显示全部"/><TextBlock Style="{StaticResource TipBody}" Text="缩放至完整视图（CAD 图纸、图片缩放后可一键恢复）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 <!-- CAD字体设置组（仅CAD模式显示） -->
 <Border x:Name="CadFontGroup" Style="{StaticResource ToolGroup}" Visibility="Collapsed">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnCadFont" Style="{StaticResource ToolBarButton}" Click="BtnCadFont_Click" Content="CAD字体" Tag="&#xE8D2;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="CAD 文字样式"/><TextBlock Style="{StaticResource TipBody}" Text="设置 CAD 图纸文字字体（SHX 主字体 + 大字体）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnCadFitAll" Style="{StaticResource ToolBarButton}" Click="BtnCadFitAll_Click" Content="显示全部" Tag="&#xE71D;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="显示全部"/><TextBlock Style="{StaticResource TipBody}" Text="CAD 图纸放大或平移后，一键将整图完整显示在当前窗口"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 <!-- 识别组 -->
 <Border Style="{StaticResource ToolGroup}">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnOcr" Style="{StaticResource ToolBarButton}" Click="BtnOcr_Click" Content="OCR" Tag="&#xE8A7;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="全页 OCR"/><TextBlock Style="{StaticResource TipBody}" Text="识别当前页全部文字（在线优先，本地引擎回退）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnOcrArea" Style="{StaticResource ToolBarButton}" Click="BtnOcrArea_Click" Content="区域" Tag="&#xE71E;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="区域 OCR"/><TextBlock Style="{StaticResource TipBody}" Text="在页面上框选区域，仅识别框内文字（自动模式）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnOcrOnline" Style="{StaticResource ToolBarButton}" Click="BtnOcrOnline_Click" Content="在线" Tag="&#xE753;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="在线全页 OCR"/><TextBlock Style="{StaticResource TipBody}" Text="强制使用在线服务识别全页文字（需先配置）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnOcrOnlineArea" Style="{StaticResource ToolBarButton}" Click="BtnOcrOnlineArea_Click" Content="在线区域" Tag="&#xE8C8;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="在线区域 OCR"/><TextBlock Style="{StaticResource TipBody}" Text="框选区域后使用在线服务识别（需先配置）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnOcrOnlineConfig" Style="{StaticResource ToolBarButton}" Click="BtnOcrOnlineConfig_Click" Content="设置" Tag="&#xE713;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="OCR 配置"/><TextBlock Style="{StaticResource TipBody}" Text="配置在线 OCR 服务地址、密钥与识别参数"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnCheck" Style="{StaticResource ToolBarButton}" Click="BtnCheck_Click" Content="检查" Tag="&#xE73E;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="规范检查"/><TextBlock Style="{StaticResource TipBody}" Text="对照规范库自动检查当前文档文字是否符合要求"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnBatch" Style="{StaticResource ToolBarButton}" Click="BtnBatch_Click" Content="批量" Tag="&#xE72C;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="批量 OCR"/><TextBlock Style="{StaticResource TipBody}" Text="批量处理多个文件的 OCR（沿用上一次识别模式）"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 <!-- 导出组 -->
 <Border Style="{StaticResource ToolGroup}">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnExportWord" Style="{StaticResource ToolBarButton}" Click="BtnExportWord_Click" Content="Word" Tag="&#xE8A5;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="导出 Word"/><TextBlock Style="{StaticResource TipBody}" Text="将 OCR 识别结果导出为 Word 文档"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnExportExcel" Style="{StaticResource ToolBarButton}" Click="BtnExportExcel_Click" Content="Excel" Tag="&#xE945;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="导出 Excel"/><TextBlock Style="{StaticResource TipBody}" Text="将 OCR 识别结果导出为 Excel 表格"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 <!-- AI组 -->
 <Border Style="{StaticResource ToolGroup}">
 <StackPanel Orientation="Horizontal">
 <Button x:Name="BtnAi" Style="{StaticResource ToolBarButton}" Click="BtnAi_Click" Content="AI助手" Tag="&#xE8BD;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="AI 助手"/><TextBlock Style="{StaticResource TipBody}" Text="打开 AI 智能对话：总结文档、校对文字、规范答疑"/></StackPanel>
 </Button.ToolTip>
 </Button>
 <Button x:Name="BtnQuery" Style="{StaticResource ToolBarButton}" Click="BtnQuery_Click" Content="查询" Tag="&#xE721;">
 <Button.ToolTip>
 <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="规范查询"/><TextBlock Style="{StaticResource TipBody}" Text="按名称或编号查询建筑规范条文与标准"/></StackPanel>
 </Button.ToolTip>
 </Button>
 </StackPanel>
 </Border>

 </StackPanel>
 </DockPanel>
 </Border>

        <!-- ═══════════════ 底部状态栏 ═══════════════ -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Width="200" Height="6" HorizontalAlignment="Right" Margin="12,0,0,0"
                             Minimum="0" Maximum="100" Value="0" />
            </DockPanel>
        </Border>

<!-- ═══════════════ 主体预览区 ═══════════════ -->
<Grid><Grid.ColumnDefinitions>
 <ColumnDefinition x:Name="ThumbTabColumn" Width="0" MinWidth="0" MaxWidth="40"/>
 <ColumnDefinition x:Name="ThumbColumn" Width="0" MinWidth="0" MaxWidth="400"/>
 <ColumnDefinition Width="Auto"/>
 <ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>

 <!-- ═══ 左侧缩略图侧边栏（白底 + 亮蓝选中 + 页码居中，PDF 查看器风格） ═══ -->
 <Border x:Name="ThumbSidebar" Background="#FFFFFF" Grid.Column="1" Visibility="Collapsed"
 BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
 <DockPanel>
 <!-- 标题栏：目录 + X 关闭 -->
 <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,4">
 <DockPanel>
 <Button x:Name="BtnCloseSidebar" Click="BtnCloseSidebar_Click" DockPanel.Dock="Right" VerticalAlignment="Center"
 Background="Transparent" BorderThickness="0" Padding="7,5" Cursor="Hand" ToolTip="收起侧栏">
 <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#4A4A4A" StrokeThickness="1.6"
 StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13"/>
 <Button.Style>
 <Style TargetType="Button">
 <Setter Property="Background" Value="Transparent"/>
 <Style.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter Property="Background" Value="#E2E8F0"/>
 </Trigger>
 </Style.Triggers>
 </Style>
 </Button.Style>
 </Button>
 <TextBlock Text="目录" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold"
 VerticalAlignment="Center" Margin="2,0,0,0"/>
 </DockPanel>
 </Border>
 <!-- 视图切换：缩略图 / 列表 -->
 <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,4">
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
 <Button x:Name="BtnThumbTab" Tag="grid" Click="SidebarTab_Click" ToolTip="缩略图视图" Cursor="Hand"
 Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Padding="8,3" Margin="0,0,4,0">
 <Grid Width="18" Height="18">
 <Path Data="M3,4 L21,4 L21,20 L3,20 Z"
 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
 StrokeThickness="1.5" Fill="Transparent"/>
 <Path Data="M3,16 L8.5,10.5 L12.5,13.8 L16.5,10 L21,15.5"
 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
 StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
 <Ellipse Width="3.2" Height="3.2"
 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15.5,4.5,0,0"/>
 </Grid>
 </Button>
 <Button x:Name="BtnListTab" Tag="list" Click="SidebarTab_Click" ToolTip="列表视图" Cursor="Hand"
 Background="Transparent" Foreground="#64748B" BorderThickness="0" Padding="8,3">
 <Grid Width="18" Height="18">
 <Ellipse Width="3" Height="3"
 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,3,0,0"/>
 <Path Data="M8,4.5 L21,4.5 M8,10.5 L21,10.5 M8,16.5 L21,16.5"
 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
 StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
 </Grid>
 </Button>
 </StackPanel>
 </Border>
 <ListBox x:Name="ThumbList" Background="Transparent" BorderThickness="0"
 ItemTemplate="{StaticResource ThumbGridTemplate}"
 ItemsSource="{Binding PageThumbItems, RelativeSource={RelativeSource AncestorType=Window}}"
 SelectionChanged="ThumbList_SelectionChanged"
 MenuItem.Click="ThumbMenuItem_Click"
 SelectionMode="Extended"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
 ScrollViewer.VerticalScrollBarVisibility="Auto">
 <ListBox.ItemContainerStyle>
 <Style TargetType="ListBoxItem">
 <Setter Property="Background" Value="Transparent"/>
 <Setter Property="BorderThickness" Value="0"/>
 <Setter Property="Padding" Value="0"/>
 <Setter Property="Margin" Value="0,0,0,0"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/>
 <Setter Property="ContextMenu">
 <Setter.Value>
 <ContextMenu>
 <MenuItem Header="↻ 右转90°" Tag="RotateRight"/>
 <MenuItem Header="↺ 左转90°" Tag="RotateLeft"/>
 </ContextMenu>
 </Setter.Value>
 </Setter>
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="ListBoxItem">
 <Border x:Name="ItemOuter" Background="Transparent" CornerRadius="3"
 Padding="3" HorizontalAlignment="Center" Margin="1,0">
 <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3"
 BorderBrush="Transparent" BorderThickness="1" Padding="0">
 <ContentPresenter/>
 </Border>
 </Border>
 <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True">
 <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD5E1"/>
 <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
 <Setter TargetName="ItemOuter" Property="Background" Value="Transparent"/>
 </Trigger>
 <Trigger Property="IsSelected" Value="True">
 <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB"/>
 <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
 <Setter TargetName="ItemOuter" Property="Background" Value="#EFF6FF"/>
 </Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate>
 </Setter.Value>
 </Setter>
 </Style>
 </ListBox.ItemContainerStyle>
 </ListBox>
 </DockPanel>
 </Border>

 <!-- 分隔线 -->
 <GridSplitter Grid.Column="2" Width="1" Background="#E2E8F0" HorizontalAlignment="Center"
 VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

 <!-- ═══ 预览区（WebView2 / CAD直接渲染） ═══ -->
 <Border Background="#F8FAFC" Grid.Column="3">
 <Grid x:Name="PreviewGrid"
 PreviewMouseLeftButtonDown="PreviewArea_MouseLeftButtonDown"
 PreviewMouseLeftButtonUp="PreviewArea_MouseLeftButtonUp"
 PreviewMouseDown="PreviewArea_MouseDown"
 PreviewMouseUp="PreviewArea_MouseUp"
 PreviewMouseMove="PreviewArea_MouseMove"
 PreviewMouseWheel="PreviewArea_MouseWheel">
 <!-- WebView2：加载 LUODA 预览服务页面 -->
 <wv2:WebView2 x:Name="PreviewWebView" Visibility="Visible" WebMessageReceived="PreviewWebView_WebMessageReceived"/>

 <!-- 图片预览（直接用 WPF Image，不走 WebView2，避免 HWND 鼠标事件问题） -->
 <Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>

 <!-- 音视频预览（file-viewer 只支持 mp4/webm/m3u8，其余格式用系统解码器播放） -->
 <MediaElement x:Name="MediaPreview" Visibility="Collapsed" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>

 <!-- CAD 直接渲染容器（不走 SVG） -->
 <ScrollViewer x:Name="CadScrollViewer" Visibility="Collapsed" Background="#2A2A2E"
 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Panel.ZIndex="10">
 <Canvas x:Name="CadHostCanvas"/>
 </ScrollViewer>

 <!-- CAD 模型/布局切换栏（左下角，类似AutoCAD） -->
 <Border x:Name="CadLayoutBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.ColumnSpan="4"
 Background="#2A2A2E" BorderBrush="#555" BorderThickness="0,1,1,0" Padding="2,2" Panel.ZIndex="100"
 IsHitTestVisible="True">
 <StackPanel Orientation="Horizontal" x:Name="CadLayoutPanel"/>
 </Border>

 <!-- 区域OCR模式时盖在WebView2上的透明拦截层（解决WebView2 HWND吞鼠标事件） -->
 <Border x:Name="OcrHitBlocker" Background="#01000000" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="150"/>
 <!-- 区域选择矩形覆盖层（最上层，IsHitTestVisible=False不拦截鼠标） -->
 <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="200">
 <Rectangle x:Name="SelectionRect" Stroke="#2563EB" StrokeThickness="2" Fill="#2563EB" Opacity="0.2" Visibility="Collapsed"/>
 </Canvas>
 <!-- 模式提示（预览区底部，不遮挡文档内容） -->
 <Border x:Name="ModeHint" Background="#EFF6FF" CornerRadius="4" Padding="8,4"
 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
 Visibility="Collapsed">
 <TextBlock x:Name="ModeHintText" Text="" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
 </Border>
 <!-- 文件加载旋转动画（预览区正中心） -->
 <Grid x:Name="FileLoadingOverlay" Background="#F8FAFC" Visibility="Collapsed" Panel.ZIndex="100"
 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
 IsVisibleChanged="FileLoadingOverlay_IsVisibleChanged">
 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <Grid Width="56" Height="56" Margin="0,0,0,16" HorizontalAlignment="Center">
 <Ellipse Width="56" Height="56" Stroke="#EFF6FF" StrokeThickness="5"/>
 <Path x:Name="FileLoadingSpinnerPath" Stroke="#2563EB" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
 Data="M 28 3 A 25 25 0 0 1 53 28">
 <Path.RenderTransform>
 <RotateTransform x:Name="FileLoadingSpinner" CenterX="28" CenterY="28" Angle="0"/>
 </Path.RenderTransform>
 </Path>
 </Grid>
 <TextBlock x:Name="FileLoadingText" Text="正在加载文件..." FontSize="15" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
 <TextBlock x:Name="FileLoadingSubText" Text="" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
 </StackPanel>
 </Grid>
 <!-- OCR 进度提示卡片（预览区居中，避免被 CAD 底部模型/布局选项卡遮挡） -->
 <Border x:Name="OcrProgressPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
 Background="#F2FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="12" Padding="20,14"
 Visibility="Collapsed" Panel.ZIndex="110">
 <Border.Effect>
 <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="#333333"/>
 </Border.Effect>
 <StackPanel Orientation="Horizontal">
 <TextBlock x:Name="OcrProgressText" Text="正在识别..." FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
 <ProgressBar x:Name="OcrProgressBar" Width="300" Height="10" Margin="14,0,0,0"
 Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
 <TextBlock x:Name="OcrProgressPercent" Text="0%" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
 </StackPanel>
 </Border>
 </Grid>
 </Border>
 </Grid>
 </DockPanel>

 <!-- ═══════════════ 启动加载覆盖层（全屏居中） ═══════════════ -->
 <Grid x:Name="LoadingOverlay" Background="#F7F8FA" Visibility="Visible" Panel.ZIndex="9999"
 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 <!-- 旋转加载圈：背景圆环 + 前景弧线（旋转） -->
 <Grid Width="70" Height="70" Margin="0,0,0,24" HorizontalAlignment="Center">
 <!-- 背景圆环 -->
 <Ellipse Width="70" Height="70" Stroke="#EFF6FF" StrokeThickness="6"/>
 <!-- 前景弧线——用Path画3/4圆弧，旋转时形成转圈动画 -->
 <Path Stroke="#2563EB" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
 HorizontalAlignment="Center" VerticalAlignment="Center">
 <Path.Data>
 <!-- 画一段3/4圆弧（从270°到180°），ArcSegment方式 -->
 <PathGeometry>
 <PathFigure IsClosed="False" StartPoint="35,4">
 <ArcSegment Point="35,66" Size="31,31" IsLargeArc="True" SweepDirection="Clockwise"/>
 <ArcSegment Point="4,35" Size="31,31" IsLargeArc="False" SweepDirection="Clockwise"/>
 </PathFigure>
 </PathGeometry>
 </Path.Data>
 <Path.RenderTransform>
 <RotateTransform x:Name="LoadingSpinner" CenterX="35" CenterY="35" Angle="0"/>
 </Path.RenderTransform>
 <Path.Triggers>
 <EventTrigger RoutedEvent="Loaded">
 <BeginStoryboard>
 <Storyboard>
 <DoubleAnimation Storyboard.TargetName="LoadingSpinner" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.0" RepeatBehavior="Forever"/>
 </Storyboard>
 </BeginStoryboard>
 </EventTrigger>
 </Path.Triggers>
 </Path>
 </Grid>
 <TextBlock x:Name="LoadingText" Text="正在启动预览服务..." FontSize="18" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
 <TextBlock x:Name="LoadingSubText" Text="请稍候..." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
 </StackPanel>
 </Grid>

</Grid>
</Window>
