<Window x:Class="LDAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LDAssistant v3.0 — 工程规范助手"
        Width="1400" Height="900"
        WindowState="Maximized"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="StatusTag" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════ 顶部工具栏 ═══════════════ -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="PageInfo" Text="无文件" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpen" Style="{StaticResource ToolBarButton}" Click="BtnOpen_Click" ToolTip="打开文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="14"/>
                            <TextBlock Text="打开" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFolder" Style="{StaticResource ToolBarButton}" Click="BtnFolder_Click" ToolTip="打开文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14"/>
                            <TextBlock Text="文件夹" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnPrev" Style="{StaticResource ToolBarButton}" Click="BtnPrev_Click" ToolTip="上一页">
                        <TextBlock Text="◀" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnNext" Style="{StaticResource ToolBarButton}" Click="BtnNext_Click" ToolTip="下一页">
                        <TextBlock Text="▶" FontSize="12"/>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

<Button x:Name="BtnZoomIn" Style="{StaticResource ToolBarButton}" Click="BtnZoomIn_Click" ToolTip="放大">
<TextBlock Text="🔍+" FontSize="12"/>
</Button>
<Button x:Name="BtnZoomOut" Style="{StaticResource ToolBarButton}" Click="BtnZoomOut_Click" ToolTip="缩小">
<TextBlock Text="🔍−" FontSize="12"/>
</Button>
<Button x:Name="BtnFitWidth" Style="{StaticResource ToolBarButton}" Click="BtnFitWidth_Click" ToolTip="等宽显示">
<TextBlock Text="↔宽" FontSize="11"/>
</Button>
<Button x:Name="BtnFitHeight" Style="{StaticResource ToolBarButton}" Click="BtnFitHeight_Click" ToolTip="等高显示">
<TextBlock Text="↕高" FontSize="11"/>
</Button>
<Button x:Name="BtnFitAll" Style="{StaticResource ToolBarButton}" Click="BtnFitAll_Click" ToolTip="适合全部">
<TextBlock Text="⤧全" FontSize="11"/>
</Button>
<Button x:Name="BtnRotate" Style="{StaticResource ToolBarButton}" Click="BtnRotate_Click" ToolTip="旋转90°">
<TextBlock Text="⟳" FontSize="14"/>
</Button>


                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

<Button x:Name="BtnOcr" Style="{StaticResource ToolBarButton}" Click="BtnOcr_Click" ToolTip="全页OCR识别">
<StackPanel Orientation="Horizontal">
<TextBlock Text="📝" FontSize="14"/>
<TextBlock Text="OCR" Margin="4,0,0,0"/>
</StackPanel>
</Button>
<Button x:Name="BtnOcrArea" Style="{StaticResource ToolBarButton}" Click="BtnOcrArea_Click" ToolTip="框选区域OCR（点击后在预览区拖拽选框）">
<StackPanel Orientation="Horizontal">
<TextBlock Text="🔲" FontSize="14"/>
<TextBlock Text="区域OCR" Margin="4,0,0,0"/>
</StackPanel>
</Button>
                    <Button x:Name="BtnCheck" Style="{StaticResource ToolBarButton}" Click="BtnCheck_Click" ToolTip="规范检查">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14"/>
                            <TextBlock Text="检查" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBatch" Style="{StaticResource ToolBarButton}" Click="BtnBatch_Click" ToolTip="批量处理">
                        <TextBlock Text="⚡批量" FontSize="12"/>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnExportWord" Style="{StaticResource ToolBarButton}" Click="BtnExportWord_Click" ToolTip="导出Word">
                        <TextBlock Text="📄Word" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnExportExcel" Style="{StaticResource ToolBarButton}" Click="BtnExportExcel_Click" ToolTip="导出Excel">
                        <TextBlock Text="📊Excel" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnAi" Style="{StaticResource ToolBarButton}" Click="BtnAi_Click" ToolTip="AI助手">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="14"/>
                            <TextBlock Text="AI" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnQuery" Style="{StaticResource ToolBarButton}" Click="BtnQuery_Click" ToolTip="规范查询">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14"/>
                            <TextBlock Text="查询" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════ 底部状态栏 ═══════════════ -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Width="200" Height="6" HorizontalAlignment="Right" Margin="12,0,0,0"
                             Minimum="0" Maximum="100" Value="0" />
            </DockPanel>
        </Border>

        <!-- ═══════════════ 主体两栏 ═══════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

	 <!-- ═══ 左栏：页面缩略图 ═══ -->
	 <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
	 <Grid>
	 <Grid.RowDefinitions>
	 <RowDefinition Height="*"/>
	 </Grid.RowDefinitions>

	 <!-- 页面缩略图 -->
	 <DockPanel Grid.Row="0">
 <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4">
 <TextBlock x:Name="ThumbTitle" Text="页面缩略图" FontSize="13" FontWeight="SemiBold"
    Foreground="#333" VerticalAlignment="Center"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
 <Button x:Name="BtnThumbSelectAll" Click="BtnThumbSelectAll_Click" ToolTip="全选/取消全选"
 Background="#F5F5F5" BorderBrush="#DDD" Padding="6,2" Margin="2,0" FontSize="11"
 Content="全选"/>
 <Button x:Name="BtnThumbRotateLeft" Click="BtnThumbRotateLeft_Click" ToolTip="选中页左旋转90°"
 Background="#F5F5F5" BorderBrush="#DDD" Padding="6,2" Margin="2,0" FontSize="11"
 Content="↺左转"/>
 <Button x:Name="BtnThumbRotateRight" Click="BtnThumbRotateRight_Click" ToolTip="选中页右旋转90°"
 Background="#F5F5F5" BorderBrush="#DDD" Padding="6,2" Margin="2,0" FontSize="11"
 Content="↻右转"/>
 </StackPanel>
 </DockPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <ItemsControl x:Name="ThumbList" ItemsSource="{Binding}">
 <ItemsControl.ItemTemplate>
 <DataTemplate>
 <Border MouseLeftButtonDown="ThumbItem_Click" Tag="{Binding}">
 <Border.Style>
 <Style TargetType="Border">
 <Setter Property="Background" Value="White"/>
 <Setter Property="BorderBrush" Value="#E0E0E0"/>
 <Setter Property="BorderThickness" Value="1"/>
 <Setter Property="CornerRadius" Value="6"/>
 <Setter Property="Margin" Value="4"/>
 <Setter Property="Padding" Value="4"/>
 <Style.Triggers>
 <DataTrigger Binding="{Binding IsActive}" Value="True">
 <Setter Property="BorderBrush" Value="#2196F3"/>
 <Setter Property="BorderThickness" Value="2"/>
 <Setter Property="Background" Value="#E3F2FD"/>
 </DataTrigger>
 <DataTrigger Binding="{Binding IsSelected}" Value="True">
 <Setter Property="BorderBrush" Value="#FF9800"/>
 <Setter Property="BorderThickness" Value="2"/>
 <Setter Property="Background" Value="#FFF3E0"/>
 </DataTrigger>
 </Style.Triggers>
 </Style>
 </Border.Style>
 <StackPanel>
 <Image Source="{Binding Thumbnail}" Width="148" Height="200"
    Stretch="Uniform" Margin="0,0,0,4"/>
 <TextBlock Text="{Binding Label}" FontSize="11"
    Foreground="#555"
    HorizontalAlignment="Center"/>
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </DockPanel>
 </Grid>
 </Border>

 <!-- ═══ 右栏：预览区（全宽） ═══ -->
 <Border Grid.Column="1" Background="#FAFAFA">
 <Grid x:Name="PreviewGrid"
 PreviewMouseLeftButtonDown="PreviewArea_MouseLeftButtonDown"
 PreviewMouseLeftButtonUp="PreviewArea_MouseLeftButtonUp"
 PreviewMouseDown="PreviewArea_MouseDown"
 PreviewMouseUp="PreviewArea_MouseUp"
 PreviewMouseMove="PreviewArea_MouseMove"
 MouseWheel="PreviewArea_MouseWheel">
 <ScrollViewer x:Name="PreviewScroll"
 HorizontalScrollBarVisibility="Auto"
 VerticalScrollBarVisibility="Auto">
 <Canvas x:Name="PreviewCanvas" Background="#E0E0E0"
 RenderTransformOrigin="0,0">
 <Canvas.RenderTransform>
 <TransformGroup>
 <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
 <RotateTransform x:Name="RotateTransform" Angle="0"/>
 </TransformGroup>
 </Canvas.RenderTransform>
 <Image x:Name="PreviewImage" Stretch="None"/>
 </Canvas>
 </ScrollViewer>
 <!-- 区域选择矩形覆盖层（不随 ScrollViewer 滚动） -->
 <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False">
 <Rectangle x:Name="SelectionRect" Stroke="#2196F3" StrokeThickness="2" Fill="#2196F3" Opacity="0.2" Visibility="Collapsed"/>
 </Canvas>
 <!-- 模式提示 -->
 <Border x:Name="ModeHint" Background="#E3F2FD" CornerRadius="4" Padding="8,4"
 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8"
 Visibility="Collapsed">
 <TextBlock x:Name="ModeHintText" Text="" FontSize="13" FontWeight="Bold" Foreground="#2196F3"/>
 </Border>
 </Grid>
 </Border>
        </Grid>
    </DockPanel>
</Window>
