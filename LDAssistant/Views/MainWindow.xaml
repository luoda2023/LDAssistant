<Window x:Class="LDAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LDAssistant v3.0 — 工程规范助手"
        Width="1400" Height="900"
        WindowState="Maximized"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="StatusTag" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════ 顶部工具栏 ═══════════════ -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="PageInfo" Text="无文件" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpen" Style="{StaticResource ToolBarButton}" Click="BtnOpen_Click" ToolTip="打开文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="14"/>
                            <TextBlock Text="打开" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFolder" Style="{StaticResource ToolBarButton}" Click="BtnFolder_Click" ToolTip="打开文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14"/>
                            <TextBlock Text="文件夹" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnPrev" Style="{StaticResource ToolBarButton}" Click="BtnPrev_Click" ToolTip="上一页">
                        <TextBlock Text="◀" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnNext" Style="{StaticResource ToolBarButton}" Click="BtnNext_Click" ToolTip="下一页">
                        <TextBlock Text="▶" FontSize="12"/>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnZoomIn" Style="{StaticResource ToolBarButton}" Click="BtnZoomIn_Click" ToolTip="放大">
                        <TextBlock Text="🔍+" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnZoomOut" Style="{StaticResource ToolBarButton}" Click="BtnZoomOut_Click" ToolTip="缩小">
                        <TextBlock Text="🔍−" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnRotate" Style="{StaticResource ToolBarButton}" Click="BtnRotate_Click" ToolTip="旋转90°">
                        <TextBlock Text="⟳" FontSize="14"/>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnOcr" Style="{StaticResource ToolBarButton}" Click="BtnOcr_Click" ToolTip="OCR识别">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="14"/>
                            <TextBlock Text="OCR" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCheck" Style="{StaticResource ToolBarButton}" Click="BtnCheck_Click" ToolTip="规范检查">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14"/>
                            <TextBlock Text="检查" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBatch" Style="{StaticResource ToolBarButton}" Click="BtnBatch_Click" ToolTip="批量处理">
                        <TextBlock Text="⚡批量" FontSize="12"/>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="6,0"/>

                    <Button x:Name="BtnExportWord" Style="{StaticResource ToolBarButton}" Click="BtnExportWord_Click" ToolTip="导出Word">
                        <TextBlock Text="📄Word" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnExportExcel" Style="{StaticResource ToolBarButton}" Click="BtnExportExcel_Click" ToolTip="导出Excel">
                        <TextBlock Text="📊Excel" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnAi" Style="{StaticResource ToolBarButton}" Click="BtnAi_Click" ToolTip="AI助手">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="14"/>
                            <TextBlock Text="AI" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════ 底部状态栏 ═══════════════ -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                <ProgressBar x:Name="Progress" Width="200" Height="6" HorizontalAlignment="Right" Margin="12,0,0,0"
                             Minimum="0" Maximum="100" Value="0" />
            </DockPanel>
        </Border>

        <!-- ═══════════════ 主体两栏 ═══════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左栏：页面缩略图 ═══ -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ThumbTitle" Text="页面缩略图" FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" Margin="10,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ThumbList" ItemsSource="{Binding}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonDown="ThumbItem_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Setter Property="Margin" Value="4"/>
                                                <Setter Property="Padding" Value="4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Width="148" Height="200"
                                                   Stretch="Uniform" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="#555"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══ 右栏：预览区（全宽） ═══ -->
            <Border Grid.Column="1" Background="#FAFAFA">
                <ScrollViewer x:Name="PreviewScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="PreviewCanvas" Background="White">
                        <Image x:Name="PreviewImage" Stretch="None"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="RotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
