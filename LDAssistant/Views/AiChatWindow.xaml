<Window x:Class="LDAssistant.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手" Width="480" Height="600"
        Background="White" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部标题 -->
        <Border DockPanel.Dock="Top" Background="#2196F3" Padding="12,8">
            <StackPanel>
                <TextBlock Text="🤖 AI 助手" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="ModelLabel" Text="模型: hermesAPI" Foreground="#BBDEFB" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 底部输入区 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel>
                <Button x:Name="BtnSend" DockPanel.Dock="Right" Content="发送" Width="60" Margin="8,0,0,0"
                        Click="BtnSend_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                <TextBox x:Name="InputBox" FontSize="13" Padding="6,4" 
                         KeyDown="InputBox_KeyDown" AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- 消息列表 -->
        <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
            <StackPanel x:Name="MsgPanel" Margin="8"/>
        </ScrollViewer>
    </DockPanel>
</Window>
