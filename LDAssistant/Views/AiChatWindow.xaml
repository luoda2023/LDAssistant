<Window x:Class="LDAssistant.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手" Width="720" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" SizeChanged="RootPanel_SizeChanged">
    <Border x:Name="RootPanel" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
            SizeChanged="RootPanel_SizeChanged">
        <!-- 显式圆角裁剪：ClipToBounds 只按矩形裁，必须用圆角 RectangleGeometry 才能让内容/图片四角真圆角 -->
        <!-- 注意：不能加 DropShadowEffect——阴影模糊会渲染进窗口内部顶角，使顶角看起来比底角小 -->
        <Border.Clip>
            <RectangleGeometry x:Name="RootClip" RadiusX="16" RadiusY="16" Rect="0,0,720,640"/>
        </Border.Clip>
        <DockPanel>
            <!-- ═══ 深蓝渐变标题栏 ═══ -->
            <Border DockPanel.Dock="Top" Height="56" CornerRadius="16,16,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B5FC4" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- 右侧：清空 / 最小化 圆形按钮 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="BtnSpecCheck" Click="BtnSpecCheck_Click" ToolTip="对照规范库检查当前文档文字" Cursor="Hand" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#22FFFFFF" CornerRadius="13" Padding="12,0" Height="26">
                                        <TextBlock Text="规范检查" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnClear" Width="28" Height="28" Click="BtnClear_Click" ToolTip="清空对话"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="14" Width="28" Height="28">
                                        <Path Data="M5,6 L6.5,6 L8,3.5 L16,3.5 L17.5,6 L19,6 L18.8,20 L5.2,20 Z M9,9 L9,17 M12,9 L12,17 M15,9 L15,17"
                                              Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="16" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnMin" Width="28" Height="28" Click="BtnMin_Click" ToolTip="最小化"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="14" Width="28" Height="28">
                                        <!-- 用 Rectangle 画横线：Path 线几何零高度时 WPF 会渲染成小点，显示不全 -->
                                        <Rectangle Width="15" Height="2" RadiusX="1" RadiusY="1" Fill="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <!-- 左侧：标题 -->
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,1 L14.2,8.8 L22,11 L14.2,13.2 L12,21 L9.8,13.2 L2,11 L9.8,8.8 Z"
                                  Fill="White" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,7,0" Stretch="Uniform"/>
                            <TextBlock Text="AI 助手" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="ModelLabel" Text="模型: hermesAPI" Foreground="#B8C7E8" FontSize="10.5"/>
                            <TextBlock x:Name="CtxStatusLabel" Text="" Foreground="#9DB2DC" FontSize="10" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ 底部输入区 ═══ -->
            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10" CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 输入框（圆角 + 占位符） -->
                    <Border Grid.Row="0" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="InputBox" FontSize="13" Padding="12,8"
                                     KeyDown="InputBox_KeyDown" AcceptsReturn="True" MaxHeight="84" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     BorderThickness="0" Background="Transparent" MinHeight="38"/>
                            <TextBlock x:Name="InputPlaceholder" Text="给 AI 下指令，Enter 发送，Shift+Enter 换行"
                                       FontSize="13" Foreground="#94A3B8" Margin="13,11,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=InputBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- 底部提示 + 发送按钮 -->
                    <Grid Grid.Row="1" Margin="2,8,2,0">
                        <TextBlock Text="由你指挥，AI 执行" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSend" Click="BtnSend_Click" ToolTip="发送（Enter）"
                                Width="38" Height="38" HorizontalAlignment="Right" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="bg" Width="38" Height="38">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Path Data="M3,11.5 L21,3 L13.5,21 L11,13 Z" Fill="White" Stroke="White"
                                              StrokeThickness="1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Stretch="Uniform"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Fill">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1D4ED8" Offset="0"/>
                                                        <GradientStop Color="#1E40AF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ 消息区 + 欢迎态 ═══ -->
            <Grid>
                <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="2,4">
                    <StackPanel x:Name="MsgPanel" Margin="12,4,12,4"/>
                </ScrollViewer>

                <!-- 欢迎态（无消息时显示） -->
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Width="72" Height="72" Fill="#EFF6FF"/>
                        <Path Data="M4,3 L20,3 A2,2 0 0 1 22,5 L22,13 A2,2 0 0 1 20,15 L11,15 L6.5,19 L7,15 L4,15 A2,2 0 0 1 2,13 L2,5 A2,2 0 0 1 4,3 Z"
                              Stroke="#2563EB" StrokeThickness="1.6" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="34" Height="32"/>
                        <Path Data="M7,8 L17,8 M7,11.5 L14,11.5" Stroke="#2563EB" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="34" Height="32"/>
                    </Grid>
                    <TextBlock Text="我是你的 AI 助手" FontSize="17" FontWeight="Bold" Foreground="#1E293B"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="可随时让我复核、修改当前页面的数据" FontSize="12.5" Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Border CornerRadius="15" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                Padding="14,7" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Pill_Summary">
                            <TextBlock Text="总结文件" FontSize="12.5" Foreground="#2563EB"/>
                        </Border>
                        <Border CornerRadius="15" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                Padding="14,7" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Pill_Check">
                            <TextBlock Text="规范检查" FontSize="12.5" Foreground="#2563EB"/>
                        </Border>
                        <Border CornerRadius="15" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                Padding="14,7" Cursor="Hand" MouseLeftButtonUp="Pill_Proof">
                            <TextBlock Text="校对文字" FontSize="12.5" Foreground="#2563EB"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
