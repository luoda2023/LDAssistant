<Window x:Class="LDAssistant.Views.OcrConfigWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="在线OCR设置" Height="520" Width="520"
		WindowStartupLocation="CenterOwner"
		Background="#F7F8FA" ResizeMode="NoResize">
	<DockPanel Margin="16">
		<!-- 底部按钮 -->
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="BtnTest" Content="测试连接" Width="100" Height="30" Margin="0,0,8,0"
					Click="BtnTest_Click"/>
			<Button x:Name="BtnSave" Content="保存" Width="80" Height="30" Margin="0,0,8,0"
					Click="BtnSave_Click" IsDefault="True"/>
			<Button x:Name="BtnCancel" Content="取消" Width="70" Height="30"
					Click="BtnCancel_Click" IsCancel="True"/>
		</StackPanel>

		<StackPanel>
			<TextBlock Text="在线OCR引擎配置" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

			<!-- 引擎选择 -->
			<TextBlock Text="OCR引擎" FontSize="13" Margin="0,0,0,4"/>
 <ComboBox x:Name="CbEngine" Width="300" Height="28" Margin="0,0,0,12"
 SelectionChanged="CbEngine_SelectionChanged">
 <ComboBoxItem Content="SiliconFlow（推荐，PaddleOCR-VL 表格+公式）" Tag="siliconflow"/>
 <ComboBoxItem Content="OCR.space（免费，支持表格）" Tag="ocrspace"/>
 </ComboBox>

			<!-- API URL -->
			<TextBlock Text="API 端点 URL" FontSize="13" Margin="0,0,0,4"/>
			<TextBox x:Name="TxtApiUrl" Width="440" Height="28" Margin="0,0,0,12"
					 FontFamily="Consolas" FontSize="12"/>

			<!-- API Key -->
			<TextBlock Text="API Key" FontSize="13" Margin="0,0,0,4"/>
			<Grid Width="440" Margin="0,0,0,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBox x:Name="TxtApiKey" Grid.Column="0" Height="28"
						 FontFamily="Consolas" FontSize="12"/>
				<Button x:Name="BtnToggleKey" Grid.Column="1" Content="👁" Width="32" Height="28"
						Margin="4,0,0,0" Click="BtnToggleKey_Click" ToolTip="显示/隐藏 Key"/>
			</Grid>

			<!-- 模型选择（仅 SiliconFlow） -->
			<TextBlock x:Name="LblModel" Text="模型" FontSize="13" Margin="0,0,0,4"/>
			<ComboBox x:Name="CbModel" Width="440" Height="28" Margin="0,0,0,12"
					  IsEditable="True"/>

			<!-- 提示词（仅 SiliconFlow） -->
			<TextBlock x:Name="LblPrompt" Text="OCR 提示词" FontSize="13" Margin="0,0,0,4"/>
			<TextBox x:Name="TxtPrompt" Width="440" Height="60" Margin="0,0,0,12"
					 TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"
					 VerticalScrollBarVisibility="Auto"/>

			<!-- 注册提示 -->
			<Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
				<StackPanel>
					<TextBlock x:Name="LblRegisterHint" FontSize="12" TextWrapping="Wrap">
						<Run Text="获取 API Key："/>
					<Run x:Name="LnkRegister" Text="点击注册" Foreground="#2563EB"
						 Cursor="Hand" MouseLeftButtonUp="LnkRegister_Click"/>
					</TextBlock>
				</StackPanel>
			</Border>
		</StackPanel>
	</DockPanel>
</Window>
