<Window x:Class="LDAssistant.Views.FabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FabWindow" Width="64" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False" Focusable="False"
        Topmost="False" SizeToContent="Manual">
    <Button x:Name="FabBtn" Click="FabBtn_Click" Cursor="Hand"
            Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
            Focusable="False" IsTabStop="False">
        <Button.ToolTip>
            <StackPanel><TextBlock Style="{StaticResource TipTitle}" Text="AI 助手"/><TextBlock Style="{StaticResource TipBody}" Text="随时打开 AI 智能对话：总结、校对、规范答疑"/></StackPanel>
        </Button.ToolTip>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="g">
                    <Ellipse x:Name="bg" Width="52" Height="52">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#6D28D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.32" Color="#1E3A8A"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <!-- 对话气泡 + 三点 -->
                    <Path Data="M4.5,3.5 L15.5,3.5 A2.5,2.5 0 0 1 18,6 L18,10 A2.5,2.5 0 0 1 15.5,12.5 L10,12.5 L6,15.5 L6.4,12.5 L4.5,12.5 A2.5,2.5 0 0 1 2,10 L2,6 A2.5,2.5 0 0 1 4.5,3.5 Z"
                          Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="20"/>
                    <Path Data="M6.5,8 L8.5,8 M10,8 L12,8 M13.5,8 L15.5,8" Stroke="White" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="20"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bg" Property="Opacity" Value="0.92"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
