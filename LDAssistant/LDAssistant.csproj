<Project Sdk="Microsoft.NET.Sdk">

 <PropertyGroup>
 <OutputType>WinExe</OutputType>
 <TargetFramework>net8.0-windows</TargetFramework>
 <UseWPF>true</UseWPF>
 <ApplicationIcon>..\app_icon.ico</ApplicationIcon>
 <AssemblyName>LDAssistant</AssemblyName>
 <RootNamespace>LDAssistant</RootNamespace>
 <Nullable>disable</Nullable>
 <ImplicitUsings>enable</ImplicitUsings>
 <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<PublishSingleFile>false</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishTrimmed>false</PublishTrimmed>
	<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
	<VersionPrefix>3.1.0</VersionPrefix>
	<AssemblyVersion>3.1.0.0</AssemblyVersion>
	<FileVersion>3.1.0.0</FileVersion>
 </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0.0" NoWarn="NU1701" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.1.25.246" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.*" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
 <PackageReference Include="ACadSharp" Version="3.*" />
 <PackageReference Include="SkiaSharp" Version="3.119.1" />
 <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
 <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

<!-- 确保原生 pdfium.dll 被复制到输出目录根目录（PdfiumViewer查找路径） -->
<Target Name="CopyPdfiumToRoot" AfterTargets="Publish">
<ItemGroup>
<Content Include="$(NuGetPackageRoot)/pdfiumviewer.native.x86_64.v8-xfa/2018.1.9/runtimes/win-x64/native/pdfium.dll" Condition="Exists('$(NuGetPackageRoot)/pdfiumviewer.native.x86_64.v8-xfa/2018.1.9/runtimes/win-x64/native/pdfium.dll')" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
<Copy SourceFiles="$(OutputPath)/x64/pdfium.dll" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutputPath)/x64/pdfium.dll')" SkipUnchangedFiles="true" />
<Copy SourceFiles="$(NuGetPackageRoot)/pdfiumviewer.native.x86_64.v8-xfa/2018.1.9/runtimes/win-x64/native/pdfium.dll" DestinationFolder="$(PublishDir)" Condition="Exists('$(NuGetPackageRoot)/pdfiumviewer.native.x86_64.v8-xfa/2018.1.9/runtimes/win-x64/native/pdfium.dll')" SkipUnchangedFiles="true" />
</Target>

	<ItemGroup>
	<Content Include="..\standards.db" Condition="Exists('..\standards.db')">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>standards.db</Link>
	</Content>
	<None Update="..\app_icon.ico">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>app_icon.ico</Link>
	</None>
	<None Update="version.json">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>version.json</Link>
	</None>
	</ItemGroup>

	<!-- CAD SHX 矢量字体文件 -->
	<ItemGroup>
	<None Include="fonts\**\*">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
	</None>
	</ItemGroup>

	<!-- RapidOCR-json 引擎（精简版，仅简体中文模型，32MB） -->
	<ItemGroup>
	<None Include="RapidOCR\**\*">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>RapidOCR\%(RecursiveDir)%(Filename)%(Extension)</Link>
	</None>
	</ItemGroup>

	<!-- file-viewer 静态资源（file-viewer 组件 + worker/wasm/字体） -->
	<ItemGroup>
	<None Include="file-viewer\**\*">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>file-viewer\%(RecursiveDir)%(Filename)%(Extension)</Link>
	</None>
	<None Include="Html\**\*">
	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	<Link>Html\%(RecursiveDir)%(Filename)%(Extension)</Link>
	</None>
	</ItemGroup>

</Project>
